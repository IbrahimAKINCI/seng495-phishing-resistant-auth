# Copy this file to ".env" and fill in your own values. Never commit ".env".
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./app.db

# Module A: key that encrypts TOTP secrets (32 bytes, base64). Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# If it is not set, a key file is created in instance/ for local development.
TOTP_ENC_KEY=

# Passkeys are bound to this site. Must match the address in the browser.
AUTH_RP_ID=localhost
AUTH_EXPECTED_ORIGIN=http://localhost:8001
